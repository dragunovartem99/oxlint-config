{
	"name": "@dragunovartem99/oxlint-config",
	"version": "3.0.1",
	"description": "Personal oxlint Config",
	"keywords": [
		"code-quality",
		"configuration",
		"linting",
		"oxlint"
	],
	"homepage": "https://github.com/dragunovartem99/oxlint-config#readme",
	"bugs": {
		"url": "https://github.com/dragunovartem99/oxlint-config/issues",
		"email": "dragunovartem99@gmail.com"
	},
	"license": "MIT",
	"author": {
		"name": "Artem Dragunov",
		"email": "dragunovartem99@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragunovartem99/oxlint-config.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./plugin": "./dist/plugin.js"
	},
	"scripts": {
		"build": "vite build",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"prepare": "husky",
		"prepublishOnly": "npm run build",
		"test": "vitest",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@dragunovartem99/oxfmt-config": "^2.1.0",
		"@oxlint/plugins": "^1.87.0",
		"husky": "^9.1.7",
		"typescript": "~7.0.0",
		"vite": "^8.1.0",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"oxlint": ">=1.71.0"
	}
}
