		"url": "git+https://github.com/dragunovartem99/oxlint-config.git"
	},
	"main": ".oxlintrc.json",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"postinstall": "ln -sf node_modules/@dragunovartem99/oxlint-config/.oxlintrc.json $INIT_CWD/.oxlintrc.json"
	},
	"devDependencies": {
